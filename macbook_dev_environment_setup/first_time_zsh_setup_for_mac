## Step 5 — Create Starship config

```bash
mkdir -p ~/.config
nano ~/.config/starship.toml
```

Paste this:

```toml
add_newline = false
command_timeout = 500

format = "$directory$git_branch$git_status$python$kubernetes$character"

[directory]
truncation_length = 3
truncate_to_repo = true
style = "bold white"

[git_branch]
format = " [$branch]($style) "
style = "bold dimmed white"

[git_status]
format = '([$all_status$ahead_behind]($style) )'
style = "bold yellow"
conflicted = "!"
ahead = "⇡${count}"
behind = "⇣${count}"
modified = "~"
untracked = "?"
staged = "+"

[python]
format = '[(\($virtualenv\))]($style) '
style = "bold dimmed cyan"
detect_files = ["requirements.txt", "pyproject.toml", ".python-version"]

[kubernetes]
disabled = true
format = '[$symbol$context\($namespace\)]($style) '
style = "bold dimmed yellow"
symbol = "☸ "

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
```

